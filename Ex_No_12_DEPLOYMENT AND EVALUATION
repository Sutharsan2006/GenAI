import gradio as gr
from transformers import pipeline
import evaluate

# --------------------------------------------------
# 1. Load the summarization model
# --------------------------------------------------

summarizer = pipeline(
    "summarization",
    model="facebook/bart-large-cnn"
)


# --------------------------------------------------
# 2. Summarization function
# --------------------------------------------------

def summarize_text(input_text):
    result = summarizer(
        input_text,
        max_length=45,
        min_length=15,
        do_sample=False
    )

    return result[0]["summary_text"]


# --------------------------------------------------
# 3. Build Gradio interface
# --------------------------------------------------

demo = gr.Interface(
    fn=summarize_text,
    inputs=gr.Textbox(
        lines=8,
        label="Enter text to summarize"
    ),
    outputs=gr.Textbox(
        label="Generated Summary"
    ),
    title="GenAI Text Summarizer",
    description="A Generative AI text summarization app built with Gradio."
)


# --------------------------------------------------
# 4. Launch application
# --------------------------------------------------

demo.launch(share=True)


# --------------------------------------------------
# 5. Evaluate generated summary using ROUGE
# --------------------------------------------------

rouge = evaluate.load("rouge")

generated_summaries = [
    "AI models generate new content such as text and images."
]

reference_summaries = [
    "Generative AI models are capable of producing new content including text and images."
]

scores = rouge.compute(
    predictions=generated_summaries,
    references=reference_summaries
)

print("ROUGE Evaluation Scores:")
print(scores)
